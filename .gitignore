patcher.py

# Local SQLite state (ephemeral on free tier; never commit)
data/*.db
data/*.db-wal
data/*.db-shm
data/webull_exec.halt
webull_trade_sdk.log
webull_data_sdk.log
*.db

# Local measurement packets. Not the version under test.
exports/
