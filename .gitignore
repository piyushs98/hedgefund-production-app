# Virtual Environments
venv/
.venv/
env/

# Secrets — never commit API keys / webhooks
.env
.env.*
!.env.example

# Runtime session baseline (midday delta vs morning brief)
data/session_baseline.json
data/session_baseline.json.tmp

# Python cache and operational garbage
__pycache__/
*.pyc
.DS_Store

# Local application logs
*.log
mac_ssl_fix.sh
patcher.py

# Local SQLite state (ephemeral on free tier; never commit)
data/*.db
*.db
