<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Not loaded by the 2026-11-14 go-live change.
  Stop the current gunicorn and bootout com.hedgefund.bot before bootstrap.
  ~/Desktop is invisible to launchd until Full Disk Access is granted.
  Logs: logs/bot-YYYY-MM-DD.log plus the two launchd files below.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.hedgefund.paperbot</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>/Users/markanthiny/Desktop/hedgefund-production-app/run_detached.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/markanthiny/Desktop/hedgefund-production-app</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>/Users/markanthiny/Desktop/hedgefund-production-app/logs/launchd-stdout.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/markanthiny/Desktop/hedgefund-production-app/logs/launchd-stderr.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PYTHONUNBUFFERED</key>
    <string>1</string>
  </dict>
</dict>
</plist>
