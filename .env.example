# Copy to .env and fill in real values. Never commit .env.

GEMINI_API_KEY=
DEEPSEEK_API_KEY=
DISCORD_WEBHOOK=
# Read-only bot for BOOK_STATE restore. Needs View Channel + Read Message History
# on the trading channel, and Message Content Intent enabled in the portal.
DISCORD_BOT_TOKEN=
# Optional; resolved from the webhook if unset.
DISCORD_CHANNEL_ID=
# Required to trade after a BOOK_STATE older than 4 calendar days (YYYY-MM-DD or 1).
# CONFIRM_STALE_BOOK=
# One-line BOOK_STATE used only when Discord history has none (first boot).
# BOOK_STATE_BOOTSTRAP=

# Optional model overrides (defaults are free-tier safe)
LLM_GEMINI_MODEL=gemini-flash-latest
TRACKER_GEMINI_MODEL=gemini-flash-latest
