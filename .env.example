# Copy to .env and fill in real values. Never commit .env.
# Copy these three from the Render dashboard. Leave every other key
# unset unless that dashboard has it set — an extra key here overrides
# a frozen default. Do not copy PORT or any RENDER_* variable.
# RESET_LEDGER_ON_BOOT must stay unset or false on this Mac.

GEMINI_API_KEY=
DEEPSEEK_API_KEY=
DISCORD_WEBHOOK=

# Optional model overrides (defaults are free-tier safe)
LLM_GEMINI_MODEL=gemini-flash-latest
TRACKER_GEMINI_MODEL=gemini-flash-latest
